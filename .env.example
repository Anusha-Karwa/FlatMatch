# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: server-only, never exposed to the browser. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without it the app works fully; the "Explain tradeoffs" and "Paste listing" buttons are hidden.
GEMINI_API_KEY=
# Optional override (default: gemini-flash-latest, an alias for the current Flash model)
# GEMINI_MODEL=gemini-3.8-flash
